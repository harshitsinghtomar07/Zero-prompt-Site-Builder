{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.bloomhouse.io/schemas/product.v2.json",
  "title": "Product",
  "description": "A handcrafted ceramic product listed in the Bloom House catalogue.",
  "type": "object",
  "required": ["sku", "name", "price"],
  "properties": {
    "sku": {
      "type": "string",
      "pattern": "^BH-[0-9]{4}$",
      "description": "Stock keeping unit, formatted BH-XXXX."
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "description": "Display name of the product."
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "exclusiveMinimum": true,
      "description": "Price in INR including GST."
    },
    "material": {
      "type": "string",
      "enum": ["stoneware", "porcelain", "terracotta", "raku"]
    },
    "leadTimeDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 45,
      "default": 14
    }
  },
  "additionalProperties": false,
  "definitions": {
    "money": { "type": "number", "multipleOf": 0.01 }
  }
}
